# Copy to .env (git-ignored) or export in your shell. Only these variables are
# read; see internal/config/config.go.

# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio_manager?sslmode=disable
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional (defaults shown)
PORT=8080
JWT_ISSUER=portfolio-manager
TOKEN_TTL=24h
LOG_LEVEL=info
# GIN_MODE is read by Gin itself; the server forces "release" when it is unset.
# GIN_MODE=debug
