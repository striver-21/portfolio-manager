# Portfolio Manager API - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file - it contains secrets

# ========== Server Configuration ==========
PORT=8080
GIN_MODE=debug  # debug, release, test

# ========== Database Configuration ==========
# PostgreSQL Connection
DATABASE_URL=host=localhost user=postgres password=postgres dbname=portfolio_manager port=5432 sslmode=disable

# Optional: SQLite for development (if using SQLite instead of PostgreSQL)
# DATABASE_URL=sqlite:portfolio.db

# ========== JWT Configuration ==========
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY_HOURS=24

# ========== Security Configuration ==========
BCRYPT_COST=10  # Cost factor for bcrypt password hashing (10-12 recommended)

# ========== API Configuration ==========
API_HOST=0.0.0.0
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ========== Logging Configuration ==========
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text

# ========== External Services (Optional) ==========
# Stock Price API (for future integration)
STOCK_API_KEY=your-api-key-here
STOCK_API_BASE_URL=https://api.example.com

# ========== Database Connection Pooling ==========
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MINUTES=5

# ========== Email Configuration (Optional) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@portfoliomanager.com

# ========== Rate Limiting ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ========== Feature Flags ==========
ENABLE_REGISTRATION=true
ENABLE_PORTFOLIO_DELETION=true
REQUIRE_EMAIL_VERIFICATION=false
